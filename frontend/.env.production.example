# 운영(배포) 모드용 환경변수 (docs/06-deployment.md §3·§6-2)
# 복사해서 사용: cp .env.production.example .env.production
#
# npm run build  → production 모드 (이 파일 사용)
#
# Railway 에 배포할 때는 이 파일 대신 서비스 Variables 에 같은 키를 등록한다.
# VITE_ 로 시작하는 값만 번들에 포함된다. 번들은 브라우저에서 그대로 보이므로 비밀값을 넣지 않는다.

# Railway 백엔드 서비스 도메인
VITE_API_BASE_URL=https://<backend>.up.railway.app

# 관리자 화면 주소. /admin 처럼 짐작하기 쉬운 값은 쓰지 않는다
# 예시 값을 그대로 쓰지 말고 무작위 문자열로 정한다 (값을 코드·문서·채팅에 남기지 않는다)
# 비워 두면 관리자 화면을 등록하지 않는다
VITE_ADMIN_PATH=

# 배포된 프론트 주소 (끝에 / 없이). 검색용 canonical·sitemap.xml 에 쓴다
# 비워 두면 둘 다 만들지 않는다 — Railway 에서 Generate Domain 으로 주소를 받은 뒤 채운다
VITE_SITE_URL=https://<frontend>.up.railway.app
