# 프론트 정적 서버 설정 (Railway · Railpack). docs/06-deployment.md 6-2절, docs/13-security-review.md S07
#
# 이 파일이 있으면 Railpack 이 기본 Caddyfile 대신 쓴다.
# 기본 설정(Railpack core/providers/node/Caddyfile.template)의 포트·SPA fallback·압축은 그대로 두고 보안 헤더만 더했다.
# Railpack 이 Go 템플릿으로 읽으므로 이중 중괄호를 쓰지 않는다. 빌드 결과 위치(/app/dist)는 직접 적는다.

{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8 # Railway 프록시를 믿는다
	}
}

# Railway 가 정해 주는 PORT 에서 듣는다. HTTPS 는 Railway 앞단이 맡는다
:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	header {
		# 다른 사이트가 이 화면을 iframe 으로 넣지 못하게 한다 (클릭재킹). CSP frame-ancestors 를 모르는 오래된 브라우저용
		X-Frame-Options "DENY"

		# 이 주소는 앞으로 1년간 HTTPS 로만 접속한다. 처음 접속하는 http 요청을 가로채는 것을 막는다
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# 서버가 알려 준 Content-Type 대로만 처리한다. 내용을 보고 형식을 추측(스니핑)하지 않는다
		X-Content-Type-Options "nosniff"

		# 다른 사이트로는 이전 주소 전체가 아니라 도메인만 보낸다. 관리자 주소·?user= 가 밖으로 나가지 않게
		Referrer-Policy "strict-origin-when-cross-origin"

		# 불러오고 실행할 수 있는 출처 목록. 인라인 스크립트는 실행하지 않는다
		# - script-src 'self'         : 우리 번들만. index.html 의 인라인 onload 를 없앤 이유
		# - style-src  + 구글 폰트 CSS : 우리 CSS 파일과 폰트 CSS
		# - font-src   구글 폰트 파일
		# - connect-src + 백엔드 주소  : API 요청은 우리 백엔드로만. 값은 Railway 변수 VITE_API_BASE_URL
		# - frame-ancestors 'none'     : X-Frame-Options 와 같은 뜻의 최신 방식
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' {$VITE_API_BASE_URL}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

		# 사용 중인 서버 프로그램 이름을 알리지 않는다
		-Server
	}

	# Vite 빌드 결과
	root * /app/dist

	file_server {
		hide .git
		hide .env*
	}

	encode {
		gzip
		zstd
	}

	# 파일이 없으면 index.html — /chat 등에서 새로고침해도 404 가 나지 않는다 (SPA fallback)
	try_files {path} {path}.html {path}/index.html /index.html
}
