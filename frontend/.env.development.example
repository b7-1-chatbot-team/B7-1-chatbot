# 개발 모드용 환경변수 (docs/06-deployment.md §3)
# 복사해서 사용: cp .env.development.example .env.development
#
# npm run dev        → development 모드 (이 파일 사용)
# npm run build:dev  → development 모드로 빌드 (개발 서버에 올려 확인할 때)
#
# VITE_ 로 시작하는 값만 번들에 포함된다. 번들은 브라우저에서 그대로 보이므로 비밀값을 넣지 않는다.

# 로컬에서 실행 중인 백엔드 주소
VITE_API_BASE_URL=http://localhost:8000

# 'true' 로 두면 백엔드 없이 MSW 로 API 를 모킹한다 (개발 모드 전용)
# 실제 백엔드에 연결하려면 false 로 되돌린다
VITE_ENABLE_MOCK=false

# 관리자 화면 주소. /admin 처럼 짐작하기 쉬운 값은 쓰지 않는다
# 예시 값을 그대로 쓰지 말고 무작위 문자열로 정한다 (값을 코드·문서·채팅에 남기지 않는다)
# 비워 두면 관리자 화면을 등록하지 않는다
VITE_ADMIN_PATH=
